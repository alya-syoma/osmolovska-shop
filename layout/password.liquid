<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {% render 'meta-tags' %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;1,6..96,400&family=Hanken+Grotesk:wght@400;600&display=swap" rel="stylesheet">
  <style>
    :root{--ink:{{ settings.color_ink }};--wall:{{ settings.color_wall }};--paper:#fff;--petal:{{ settings.color_petal }};--petal-deep:{{ settings.color_petal_deep }};--text:#1d191b;--muted:#6f6669;--muted-dark:#b6abae;--line:rgba(20,17,19,.12);--display:'Bodoni Moda',Didot,serif;--body:'Hanken Grotesk',system-ui,sans-serif}
  </style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  {{ content_for_layout }}
</body>
</html>
