<section class="rooms" id="rooms-{{ section.id }}">
  <div class="wrap room-grid">
    <div class="room-stage" data-room-stage>
      {%- for block in section.blocks -%}
        {%- if forloop.first -%}{%- assign cls = 'room-img on' -%}{%- else -%}{%- assign cls = 'room-img' -%}{%- endif -%}
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 1400 | image_tag: alt: block.settings.title, class: cls, loading: 'lazy' }}
        {%- else -%}
          <img class="{{ cls }}" src="{{ block.settings.fallback | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="975" height="1300">
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="room-side">
      <span class="label">{{ section.settings.label }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <div class="room-tabs" data-room-tabs>
        {%- for block in section.blocks -%}
          <button class="room-tab{% if forloop.first %} on{% endif %}" type="button" data-r="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 240 | image_tag: alt: '', loading: 'lazy' }}
            {%- else -%}
              <img src="{{ block.settings.fallback | asset_url }}" alt="" loading="lazy" width="240" height="240">
            {%- endif -%}
            {{ block.settings.title }}
          </button>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "In your room",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label", "default": "In your room" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See it on your wall" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Large botanicals change a room. Switch between interiors to see the scale." }
  ],
  "blocks": [
    {
      "type": "room",
      "name": "Room",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Interior photo" },
        { "type": "text", "id": "title", "label": "Room name", "default": "Living room" },
        { "type": "text", "id": "fallback", "label": "Default image file (theme asset)", "default": "room-1.jpg" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{
    "name": "In your room",
    "blocks": [
      { "type": "room", "settings": { "title": "Living room", "fallback": "room-1.jpg" } },
      { "type": "room", "settings": { "title": "Library", "fallback": "room-2.jpg" } },
      { "type": "room", "settings": { "title": "Lounge", "fallback": "room-3.jpg" } }
    ]
  }]
}
{% endschema %}
