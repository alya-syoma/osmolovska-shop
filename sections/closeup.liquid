<section class="closeup">
  <div class="wrap">
    <div class="head">
      <div><span class="label">{{ section.settings.label }}</span><h2>{{ section.settings.heading }}</h2></div>
      <p>{{ section.settings.text }}</p>
    </div>
    <div class="close-grid">
      {%- for block in section.blocks -%}
        <figure {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1000 | image_tag: alt: block.settings.title, loading: 'lazy' }}
          {%- else -%}
            <img src="{{ block.settings.fallback | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="825" height="1100">
          {%- endif -%}
          <figcaption><b>{{ block.settings.title }}</b>{{ block.settings.caption }}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Up close",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label", "default": "Up close" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Look closer. It's paint." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every vein and drop of dew is built up in thin layers of oil, brush by brush." }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Detail photo" },
        { "type": "text", "id": "title", "label": "Title", "default": "Peony" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "detail, oil on canvas" },
        { "type": "text", "id": "fallback", "label": "Default image file (theme asset)", "default": "detail-peony.jpg" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{
    "name": "Up close",
    "blocks": [
      { "type": "detail", "settings": { "title": "Peony", "fallback": "detail-peony.jpg" } },
      { "type": "detail", "settings": { "title": "Lotus", "fallback": "detail-lotus.jpg" } },
      { "type": "detail", "settings": { "title": "Papaya", "fallback": "detail-papaya.jpg" } }
    ]
  }]
}
{% endschema %}
