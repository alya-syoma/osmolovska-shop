<section class="intro password">
  <span class="label">Coming soon</span>
  <div class="intro-name">{{ shop.name }}</div>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'customer', class: 'collect-form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter,prelaunch">
    {%- if form.posted_successfully? -%}
      <p class="form-note" role="status">Thank you! We'll let you know when we open.</p>
    {%- else -%}
      <input type="email" name="contact[email]" required placeholder="Your email" aria-label="Email address">
      <button class="btn btn-petal" type="submit">Notify me</button>
    {%- endif -%}
  {%- endform -%}
  <details class="password-login">
    <summary>Enter with password</summary>
    {%- form 'storefront_password' -%}
      {{ form.errors | default_errors }}
      <input type="password" name="password" placeholder="Password" aria-label="Password">
      <button class="btn btn-line" type="submit">Enter</button>
    {%- endform -%}
  </details>
</section>
{% schema %}
{ "name": "Password page", "settings": [] }
{% endschema %}
