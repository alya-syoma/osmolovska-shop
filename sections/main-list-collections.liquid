<section class="collection-page">
  <div class="wrap">
    <div class="head"><div><span class="label">Series</span><h1>All series</h1></div></div>
    <div class="series-grid">
      {%- for collection in collections -%}
        {%- if collection.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
        <a class="series-card" href="{{ collection.url }}">
          {%- if collection.featured_image -%}
            {{ collection.featured_image | image_url: width: 900 | image_tag: alt: collection.title, loading: 'lazy' }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
          <span>{{ collection.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}
