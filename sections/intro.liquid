{%- liquid
  assign fallback = 'w-lotus.jpg,w-dahlia.jpg,w-crown-imperial.jpg' | split: ','
-%}
<section class="intro" aria-label="Welcome">
  {%- if section.settings.label != blank -%}<span class="label">{{ section.settings.label }}</span>{%- endif -%}
  <div class="triptych" aria-hidden="true">
    {%- for i in (1..3) -%}
      {%- assign key = 'image_' | append: i -%}
      {%- assign img = section.settings[key] -%}
      {%- if img != blank -%}
        {{ img | image_url: width: 900 | image_tag: alt: '', loading: 'eager', sizes: '(max-width: 640px) 80vw, 30vw' }}
      {%- else -%}
        {%- assign idx = i | minus: 1 -%}
        <img src="{{ fallback[idx] | asset_url }}" alt="" loading="eager" width="700" height="933">
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="intro-name">{{ section.settings.name_first }} <em>{{ section.settings.name_second }}</em></div>
  {%- if section.settings.tagline != blank -%}<p>{{ section.settings.tagline }}</p>{%- endif -%}
  <a href="#intro-end-{{ section.id }}" class="intro-enter">{{ section.settings.enter_label }}<i></i></a>
</section>
<div id="intro-end-{{ section.id }}"></div>

{% schema %}
{
  "name": "Intro screen",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label", "default": "Hyperrealist oil paintings" },
    { "type": "image_picker", "id": "image_1", "label": "Left painting" },
    { "type": "image_picker", "id": "image_2", "label": "Centre painting (shown on phones)" },
    { "type": "image_picker", "id": "image_3", "label": "Right painting" },
    { "type": "text", "id": "name_first", "label": "Name", "default": "Osmolovska" },
    { "type": "text", "id": "name_second", "label": "Name accent (italic)", "default": "Art" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Flowers, painted larger than life." },
    { "type": "text", "id": "enter_label", "label": "Scroll button", "default": "Enter the gallery" }
  ],
  "presets": [{ "name": "Intro screen" }]
}
{% endschema %}
