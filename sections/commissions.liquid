<section class="commissions" id="commissions">
  <div class="wrap">
    <div class="head">
      <div><span class="label">{{ section.settings.label }}</span><h2>{{ section.settings.heading }}</h2></div>
      <p>{{ section.settings.text }}</p>
    </div>
    <div class="steps">
      {%- for block in section.blocks -%}
        <div class="step" {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <div class="commission-cta"><a class="btn btn-ink" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a><span>{{ section.settings.note }}</span></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Commissions",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label", "default": "Commissions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A painting made for you" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Choose a flower, a size and a palette. I paint it for your space." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Start a commission" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "note", "label": "Note next to the button" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Step" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [{
    "name": "Commissions",
    "blocks": [
      { "type": "step", "settings": { "title": "Brief", "text": "Tell me about the flower, size and room." } },
      { "type": "step", "settings": { "title": "Sketch", "text": "You approve a composition and palette." } },
      { "type": "step", "settings": { "title": "Painting", "text": "I paint it, with progress photos along the way." } },
      { "type": "step", "settings": { "title": "Delivery", "text": "Insured shipping to your door." } }
    ]
  }]
}
{% endschema %}
