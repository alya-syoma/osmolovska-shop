{%- assign collection = section.settings.collection -%}
<section class="works-section" id="works">
  <div class="wrap">
    <div class="head">
      <div>
        {%- if section.settings.label != blank -%}<span class="label">{{ section.settings.label }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="filters" role="list">
        <a class="chip active" role="listitem" href="{{ collection.url | default: routes.all_products_collection_url }}">All</a>
        {%- for block in section.blocks -%}
          {%- if block.settings.collection != blank -%}
            <a class="chip" role="listitem" href="{{ block.settings.collection.url }}" {{ block.shopify_attributes }}>{{ block.settings.collection.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="works">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="work">
            <div class="frame">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
            <div class="meta"><div><h3>Artwork title</h3><small>Oil on canvas</small></div><div class="price">$0</div></div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if collection != blank -%}
      <div class="center"><a class="btn btn-line-dark" href="{{ collection.url }}">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured works",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label", "default": "Available works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest originals" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Each painting is a one-of-a-kind original in oil on canvas." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Works to show", "min": 4, "max": 24, "step": 4, "default": 8 },
    { "type": "text", "id": "button_label", "label": "Button", "default": "View all works" }
  ],
  "blocks": [
    {
      "type": "series",
      "name": "Series filter",
      "settings": [{ "type": "collection", "id": "collection", "label": "Series collection" }]
    }
  ],
  "presets": [{ "name": "Featured works" }]
}
{% endschema %}
